generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum HouseholdRole {
  OWNER
  MEMBER
}

// Auth.js (NextAuth) Standardschema für den Prisma-Adapter. `User` trägt
// ausschließlich Identitätsdaten (Login, Name, E-Mail). Ernährungsbezogene
// Daten (Ziele, Präferenzen, Rezepte, Log, Pläne) bleiben an `Profile`, das
// per `userId` 1:1 an genau einen `User` gebunden ist. `Account`/`Session`/
// `VerificationToken` werden aktuell nur für den Credentials-Login (JWT-
// Sessions) nicht zwingend gebraucht, bleiben aber im Schema, damit spätere
// OAuth-Provider ohne erneute Migration ergänzt werden können.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // Nullable: ein aus dem alten Single-Profile-Datensatz migrierter Nutzer
  // hat zunächst kein Passwort, bis er es über den Setup-Flow selbst vergibt.
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  profile             Profile?
  householdMembership HouseholdMember?
  assistantRequests   AssistantRequest[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// Ein Haushalt bündelt mehrere User (z.B. Familie/WG). Gemeinsame Ressourcen
// (Pantry, Shopping List, Budget, geteilte Rezepte) hängen an `Household`,
// nicht an einzelne `Profile` (siehe Kapitel 6/8). v1: ein User gehört zu
// maximal einem Haushalt (`userId` ist unique auf HouseholdMember) -
// ausreichend für "mehrere echte Nutzer in einem gemeinsamen Haushalt"
// (Kapitel 9), Multi-Household-Mitgliedschaft ist bewusst kein Ziel dieses
// Kapitels und wird nicht vorgebaut.
model Household {
  id       String @id @default(cuid())
  name     String
  // Vorbereitete Einstellung (Kapitel 9): Default-Währung des Haushalts,
  // aktuell noch nicht in Budget-Formularen verdrahtet (die haben bereits
  // ihren eigenen EUR-Default, siehe Kapitel 8), aber schon editierbar.
  // Timezone/Serving-Konventionen bewusst NICHT ergänzt: nichts in der
  // bestehenden Architektur wertet sie aus, ein ungenutztes Feld wäre eine
  // erfundene Einstellung ohne echten Effekt.
  currency Currency @default(EUR)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      HouseholdMember[]
  invites      HouseholdInvite[]
  pantryItems  PantryItem[]
  foodBudgets  FoodBudget[]
  foodExpenses FoodExpense[]
  foodPrices   FoodPrice[]
  mealPlans    MealPlan[]
}

model HouseholdMember {
  id          String        @id @default(cuid())
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String        @unique
  role        HouseholdRole @default(OWNER)
  // Individueller Portionsfaktor innerhalb des Haushalts (Dynamic Portions,
  // Kapitel 16), z.B. 1.3 für ein größeres Familienmitglied, 0.6 für ein Kind.
  portionFactor Float @default(1)
  joinedAt      DateTime @default(now())

  mealPlanMemberships MealPlanMember[]
  mealPlanMeals       MealPlanMeal[]
}

// Minimal-sichere Einladungs-Basis (Kapitel 9): kein E-Mail-Versand in der
// bestehenden Architektur vorhanden (siehe src/lib/providers/), daher trägt
// der Owner den Link manuell weiter, statt eine Fake-Mail-Funktion
// vorzutäuschen. Der Roh-Token wird NIE gespeichert, nur sein SHA-256-Hash
// (siehe household/token.ts) - ein DB-Leak macht keinen Token verwendbar.
// `role` wird bei der Erzeugung auf MEMBER beschränkt (siehe
// validation/household.ts): Ownership kann ausschließlich per expliziter
// Übertragung wechseln, nie per Invite, damit nie zwei OWNER gleichzeitig
// entstehen können.
model HouseholdInvite {
  id          String    @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String

  invitedEmail String
  role         HouseholdRole @default(MEMBER)
  tokenHash    String        @unique
  expiresAt    DateTime
  acceptedAt   DateTime?

  createdAt DateTime @default(now())
}

enum Sex {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY // Bürojob, kaum Bewegung
  LIGHT // 1-3x Sport/Woche
  MODERATE // 3-5x Sport/Woche
  HIGH // 6-7x Sport/Woche
  ATHLETE // 2x täglich / körperliche Arbeit + Sport
}

enum Goal {
  LOSE_WEIGHT
  MAINTAIN
  GAIN_MUSCLE
  GAIN_WEIGHT
}

enum SportType {
  ENDURANCE // Ausdauer/Cardio
  STRENGTH // Powerlifting/Krafttraining
  ATHLETIC // Athletik/Funktionell
  TEAM_SPORT // Fußball etc.
  MIXED
  NONE
}

enum DietType {
  OMNIVORE
  VEGETARIAN
  VEGAN
  PESCETARIAN
  KETO
  LOW_CARB
  HALAL
  KOSHER
  PALEO
}

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  PRE_WORKOUT
  POST_WORKOUT
}

model Profile {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  age       Int
  sex       Sex
  heightCm  Float
  weightKg  Float

  activityLevel ActivityLevel
  goal          Goal
  goalRateKgPerWeek Float @default(0.5) // Tempo für Ab-/Zunahme

  sportType SportType @default(NONE)

  dietType  DietType  @default(OMNIVORE)

  likedFoods    ProfileTag[] @relation("LikedFoods")
  dislikedFoods ProfileTag[] @relation("DislikedFoods")
  allergies     ProfileTag[] @relation("Allergies")
  priorities    ProfileTag[] @relation("Priorities") // z.B. "günstig", "schnell", "high-protein"

  subscribedTrendTags String @default("[]") // JSON-Array abonnierter Trend-Tags, z.B. ["vegan","airfryer"]

  trainingSessions TrainingSession[]
  logEntries       LogEntry[]
  mealPlanDays     MealPlanDay[]
  customRecipes    Recipe[] @relation("CustomRecipes")
  assistantMessages AssistantMessage[]
  dismissedInsights DismissedInsight[]
}

// Generic tag table reused for liked/disliked/allergy/priority lists
model ProfileTag {
  id    String @id @default(cuid())
  label String

  likedByProfile    Profile? @relation("LikedFoods", fields: [likedByProfileId], references: [id])
  likedByProfileId  String?
  dislikedByProfile   Profile? @relation("DislikedFoods", fields: [dislikedByProfileId], references: [id])
  dislikedByProfileId String?
  allergyOfProfile    Profile? @relation("Allergies", fields: [allergyOfProfileId], references: [id])
  allergyOfProfileId  String?
  priorityOfProfile   Profile? @relation("Priorities", fields: [priorityOfProfileId], references: [id])
  priorityOfProfileId String?
}

model TrainingSession {
  id        String   @id @default(cuid())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String

  weekday   Int // 0 = Montag ... 6 = Sonntag
  startTime String // "HH:mm"
  durationMin Int
  sportType SportType
  intensity Int // 1-5
}

model Recipe {
  id          String   @id @default(cuid())
  name        String
  description String
  imageQuery  String? // Stichwort für Platzhalterbild

  kcal        Int
  proteinG    Float
  carbsG      Float
  fatG        Float

  prepTimeMin Int
  servings    Int      @default(1)
  mealSlots   String // JSON-Array kompatibler MealSlot-Werte, z.B. ["LUNCH","DINNER"]
  dietTypes   String // JSON-Array kompatibler DietType-Werte
  allergens   String // JSON-Array enthaltener Allergene/Trigger, z.B. ["gluten","nuts"]
  ingredients String // JSON-Array von Zutaten-Strings mit Menge, z.B. "2 Gurken" (auch für Liked/Disliked-Matching)
  instructions String // JSON-Array einzelner Zubereitungsschritte
  tags         String @default("[]") // JSON-Array freier Tags, z.B. ["vegan","airfryer","high-protein"]

  isTrending    Boolean  @default(false)
  trendSource   String? // z.B. "TikTok/Insta-Trend Sommer 2026"
  trendAddedAt  DateTime?

  isCustom        Boolean  @default(false)
  ownerProfile    Profile? @relation("CustomRecipes", fields: [ownerProfileId], references: [id], onDelete: Cascade)
  ownerProfileId  String?
  createdAt       DateTime @default(now())

  // Nutrition Engine: woher stammen die Nährwerte? DATABASE = manuell/deterministisch
  // gepflegt, AI_ESTIMATE = vom Recipe Transformer geschätzt und klar als solches
  // zu kennzeichnen (nie stillschweigend wie ein verifizierter Wert behandeln).
  nutritionSource      String  @default("DATABASE")
  generatedByAssistant Boolean @default(false)

  // ---- Rezeptdatenbank (Personalisierungs-Grundlage) ----
  // Alle Felder optional/mit Default, damit bestehende Rezepte (Freitext-
  // Zutaten, feste Nährwerte) unverändert gültig bleiben. `nutritionSource`
  // = "COMPUTED" heißt: kcal/Makros wurden aus den strukturierten
  // `ingredientRows` berechnet (siehe src/lib/recipes/nutrition.ts), die
  // festen Spalten oben sind dann nur der gespeicherte Ergebnis-Snapshot.
  slug         String? @unique // stabiler Schlüssel für idempotentes Seeden, z.B. "protein-pancakes-with-berries"
  category     String? // Hauptkategorie: breakfast|lunch|dinner|snack|dessert|pre-workout|post-workout
  cookTimeMin  Int?
  totalTimeMin Int? // prepTimeMin + cookTimeMin; Anzeige/Filter nutzen totalTimeMin ?? prepTimeMin
  difficulty   String? // easy|medium
  cuisine      String?
  equipment    String @default("[]") // JSON-Array

  fiberG        Float?
  sugarG        Float?
  saturatedFatG Float?
  sodiumMg      Float?

  mealPrepSuitable Boolean @default(false)
  storageDays      Int? // nur setzen, wenn eine belastbare Angabe existiert
  storage          String? // FRIDGE|FREEZER|ROOM_TEMPERATURE

  // internal = mitgelieferte Seed-Rezepte, user = eigene Rezepte, external = spätere Importe.
  sourceType       String  @default("internal")
  sourceProvider   String?
  sourceExternalId String?

  ingredientRows RecipeIngredient[]

  logEntries    LogEntry[]
  mealPlanItems MealPlanItem[]
  mealPlanMeals MealPlanMeal[]

  // Gesetzt nur für Rezepte, die über den Import-Publish (Kapitel 21) entstanden sind.
  importCandidate RecipeImportCandidate?
}

// Strukturierte Zutat eines Rezepts: verweist auf die zentrale Food-Entität
// (`Ingredient`), damit Nährwerte, Alternativen, Allergene, Präferenzen,
// Vorrat und Preise überall dieselbe Lebensmittel-Definition nutzen. Das
// Freitext-Array `Recipe.ingredients` bleibt für alle bestehenden Konsumenten
// (Planner, Soft-Scoring, Meal Prep, Insights) erhalten und wird beim Seeden
// aus diesen Zeilen erzeugt - EINE Quelle, zwei Darstellungen.
model RecipeIngredient {
  id       String @id @default(cuid())
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId String
  position Int

  food   Ingredient? @relation(fields: [foodId], references: [id])
  foodId String?

  displayName String // so wie im Rezept gezeigt, z.B. "Joghurt" (Food: Naturjoghurt)
  amount      Float? // null = nach Geschmack / ohne Mengenangabe
  unit        String? // g|ml|tl|el|piece|slice|can|pinch
  optional    Boolean @default(false)
  note        String? // z.B. "ungekocht gewogen"
  gramsOverride Float? // Gewicht der Menge, wenn sie vom Standard des Foods abweicht (z.B. große Tortilla)

  @@index([recipeId])
  @@index([foodId])
}

// ---- Recipe Import Queue (Kapitel 21) ----

// Ein extern importiertes Rezept, das intern geprüft wird, bevor es (vielleicht) Teil des
// Katalogs wird. Rohdaten (`rawPayload`, unverändert wie von der Quelle geliefert) und
// normalisierte Daten (`ingredients` usw., Ergebnis der Kapitel-20-Pipeline) liegen bewusst
// getrennt. Bewertungen (Validierung, Nährwerte, Duplikate, Quality) werden NICHT gespeichert,
// sondern bei jedem Laden neu aus diesen Daten berechnet - sie können also nie veralten.
// Ein Katalog-Rezept entsteht ausschließlich über die explizite Publish-Aktion
// (src/lib/recipes/importQueueService.ts), danach verweist `publishedRecipeId` darauf.
model RecipeImportCandidate {
  id String @id @default(cuid())

  sourceType       String // mock|manual|external_api|social_media (ImportSource.type)
  sourceProvider   String // lesbarer Name der Quelle (ImportSource.label), Teil der Quellen-Identität
  sourceExternalId String?
  sourceUrl        String?

  name        String
  description String @default("")

  rawPayload String // JSON: der vollständige RawImportedRecipe, unverändert

  ingredients  String   // JSON: StoredImportIngredient[] (normalisiert, inkl. Originaltext und Food-Auflösung)
  instructions String   @default("[]") // JSON-Array
  servings     Int
  prepTimeMin  Int?
  tags         String   @default("[]") // JSON-Array, wie von der Quelle geliefert
  imageRef     String?
  importedAt   DateTime

  // pending_review|needs_changes|approved|rejected|published|failed, siehe importWorkflow.ts
  status String @default("pending_review")

  // Reviewer-Entscheidung beim Approve: IDs der möglichen Duplikate, die bewusst in Kauf genommen
  // wurden. Der Publish prüft, dass seitdem keine weiteren hinzugekommen sind.
  acknowledgedDuplicateIds String @default("[]")

  publishedRecipe   Recipe? @relation(fields: [publishedRecipeId], references: [id], onDelete: SetNull)
  publishedRecipeId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events RecipeImportEvent[]

  // Verhindert eine doppelte Queue-Anlage bei verlässlicher Quellen-ID. SQLite behandelt NULL in
  // Unique-Indizes als verschieden: ohne externe ID wird bewusst NICHT dedupliziert (nie nur über Namen).
  @@unique([sourceType, sourceProvider, sourceExternalId])
  @@index([status])
}

// Audit Trail je Kandidat: jede Statusänderung, Food-Zuordnung und jedes Publish-Ergebnis.
// `actorUserId` bewusst ohne Relation zu User: der Eintrag soll auch nach dem Löschen eines Users
// nachvollziehbar bleiben. Keine E-Mail oder andere personenbezogenen Daten.
model RecipeImportEvent {
  id          String                @id @default(cuid())
  candidate   RecipeImportCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId String

  action      String  // imported|needs_changes|resubmitted|rejected|approved|food_assigned|published|publish_blocked|publish_error
  fromStatus  String?
  toStatus    String
  note        String?
  actorUserId String?
  recipeId    String? // bei "published": das erstellte Katalog-Rezept
  details     String? // JSON mit strukturierten Zusatzdaten (z.B. Blocker, Food-Zuordnung)

  createdAt DateTime @default(now())

  @@index([candidateId])
}

enum AssistantRole {
  USER
  ASSISTANT
}

model AssistantMessage {
  id        String         @id @default(cuid())
  profile   Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String

  role      AssistantRole
  content   String
  // JSON: welche Tools mit welchen Parametern aufgerufen wurden (Transparenz/Debug),
  // z.B. [{"tool":"search_recipes","input":{...},"resultRecipeIds":["..."]}]
  toolCalls String?

  createdAt DateTime @default(now())
}

// Eine zur LLM-Verarbeitung zugelassene Assistant-Anfrage (F-20). Grundlage für die Limits pro
// Nutzer (Anzahl Zeilen im Stunden-/Tagesfenster) und für "höchstens eine aktive Anfrage":
// `activeUserId` trägt die userId, solange die Anfrage läuft, und ist unique - eine zweite
// gleichzeitige Anfrage desselben Nutzers scheitert atomar am Index. Beim Abschluss wird das
// Feld auf null gesetzt (mehrere NULL sind in SQLite und PostgreSQL erlaubt), die Zeile bleibt
// für die Zählung stehen. Logik: src/lib/agents/assistantUsage.ts
model AssistantRequest {
  id           String    @id @default(cuid())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  activeUserId String?   @unique

  @@index([userId, startedAt])
}

model LogEntry {
  id        String   @id @default(cuid())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String

  date      DateTime // Tag des Eintrags (ohne Uhrzeit relevant)
  slot      MealSlot

  recipe    Recipe?  @relation(fields: [recipeId], references: [id])
  recipeId  String?

  // Für freie Einträge ohne Rezeptbezug
  customName String?
  kcal       Int
  proteinG   Float
  carbsG     Float
  fatG       Float

  createdAt DateTime @default(now())
}

model MealPlanDay {
  id        String   @id @default(cuid())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String

  date      DateTime

  targetKcal    Int
  targetProteinG Float
  targetCarbsG   Float
  targetFatG     Float

  items     MealPlanItem[]

  @@unique([profileId, date])
}

model MealPlanItem {
  id            String      @id @default(cuid())
  mealPlanDay   MealPlanDay @relation(fields: [mealPlanDayId], references: [id], onDelete: Cascade)
  mealPlanDayId String

  slot      MealSlot
  time      String // "HH:mm" empfohlene Uhrzeit
  portionMultiplier Float @default(1) // Portionsgröße relativ zum Basisrezept, angepasst an das Kalorienziel des Slots

  recipe    Recipe @relation(fields: [recipeId], references: [id])
  recipeId  String
}

// ---- Pantry (Kapitel 6) ----

enum PantryUnit {
  G
  KG
  ML
  L
  PIECE
  PACK
  PORTION
}

enum PantryLocation {
  FRIDGE
  FREEZER
  PANTRY
  CUPBOARD
  OTHER
}

enum ExpirationDateType {
  EXACT
  ESTIMATED
  UNKNOWN
}

// Zentrale Food-Entität. Wird beim Anlegen eines PantryItem per normalisiertem
// Namen automatisch gefunden oder neu angelegt (dann bewusst ohne erfundene
// Daten). Kuratierte Foods (`slug` gesetzt, siehe src/lib/recipes/data/foods.ts)
// tragen zusätzlich Kategorie, Allergene, Aliase, Diät-Klasse und Nährwerte je
// 100 g/ml. Pantry-Einträge mit gleichem Namen verknüpfen sich dadurch von
// selbst mit dem kuratierten Food. Nährwerte sind Referenz-/Richtwerte, keine
// verifizierten Herstellerangaben (der NutritionProvider bleibt für Barcodes zuständig).
model Ingredient {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  defaultUnit    PantryUnit?
  createdAt      DateTime @default(now())

  slug      String? @unique // stabile Food-ID der Seed-Daten, z.B. "skyr"
  category  String? // dairy|poultry|grain|...
  dietClass String? // vegan|vegetarian|pescatarian|omnivore: restriktivste Ernährungsform, mit der das Food vereinbar ist
  aliases   String  @default("[]") // JSON-Array normalisierter Alternativnamen, z.B. ["hähnchen","hühnchen"]
  allergens String  @default("[]") // JSON-Array, gleiches Vokabular wie Recipe.allergens
  // "true" = Gewürz o.ä.: trägt nie zu Nährwerten bei, auch mit Mengenangabe ("1 Prise Salz").
  negligible Boolean @default(false)
  // JSON {"ml":1.03,"piece":55,"slice":45,"tl":4.6,"el":13.8,"can":130}: Gramm je Einheit.
  unitGrams String?

  // Nährwerte je 100 g (bzw. 100 ml bei Flüssigkeiten); alle null = keine Angabe.
  kcalPer100          Float?
  proteinPer100G      Float?
  carbsPer100G        Float?
  fatPer100G          Float?
  fiberPer100G        Float?
  sugarPer100G        Float?
  saturatedFatPer100G Float?
  sodiumPer100Mg      Float?

  pantryItems       PantryItem[]
  foodPrices        FoodPrice[]
  recipeIngredients RecipeIngredient[]
  alternatives      IngredientAlternative[] @relation("FoodAlternativesFrom")
  alternativeFor    IngredientAlternative[] @relation("FoodAlternativesTo")
}

// Zentral gepflegte, gerichtete Alternative: "in einem Rezept mit `from` kann
// `to` verwendet werden". Bewusst gerichtet (nicht automatisch symmetrisch):
// Skyr -> Magerquark ist sinnvoll, Magerquark -> Skyr wird separat gepflegt.
// `requiresContext` = die Alternative passt nur, wenn das konkrete Rezept es
// hergibt (z.B. Avocado -> Hummus); solche Kanten werden nie automatisch
// eingesetzt, nur als Möglichkeit gemeldet.
model IngredientAlternative {
  id     String     @id @default(cuid())
  from   Ingredient @relation("FoodAlternativesFrom", fields: [fromFoodId], references: [id], onDelete: Cascade)
  fromFoodId String
  to     Ingredient @relation("FoodAlternativesTo", fields: [toFoodId], references: [id], onDelete: Cascade)
  toFoodId String

  type            String // similar|dietary|vegan|dairy-free|lactose-free|gluten-free|lower-calorie|higher-protein
  requiresContext Boolean @default(false)
  note            String?

  @@unique([fromFoodId, toFoodId])
  @@index([toFoodId])
}

// Konkreter Vorratsbestand (nicht das Lebensmittel an sich, siehe Ingredient).
// Gehört einem Haushalt, nicht einem einzelnen User, damit "gemeinsame
// Pantry" (siehe Household-Kommentar) von Anfang an möglich ist.
model PantryItem {
  id          String    @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String

  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id])
  ingredientId String?

  name              String
  quantity          Float // ursprünglich erfasste/gekaufte Menge
  remainingQuantity Float // aktuell noch vorhandene Menge, siehe src/lib/pantry/adjustQuantity.ts
  unit              PantryUnit
  category          String?

  purchaseDate DateTime?
  // Bewusst getrennt von expirationDateType: ein Datum allein sagt nicht, ob
  // es sich um ein echtes Herstellerdatum oder eine Schätzung handelt.
  expirationDate     DateTime?
  expirationDateType ExpirationDateType @default(UNKNOWN)

  location PantryLocation @default(OTHER)
  opened   Boolean        @default(false)
  cooked   Boolean        @default(false)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---- Food Budget System (Kapitel 8) ----

// Nur EUR in v1 (keine automatische Umrechnung). Als Enum statt Freitext
// angelegt, damit spätere Währungen ohne Schema-Formwechsel ergänzt werden
// können, genau wie bei den übrigen kontrollierten Enums dieses Projekts.
enum Currency {
  EUR
}

enum BudgetPeriodType {
  WEEK
  MONTH
}

enum FoodExpenseCategory {
  GROCERIES
  RESTAURANT
  TAKEAWAY
  OTHER
}

// Woher ein FoodPrice-Eintrag stammt. Aktuell wird ausschließlich
// USER_ENTERED erzeugt (kein Preis-Provider existiert, siehe
// src/lib/providers/priceProvider.ts), IMPORTED/PROVIDER liegen bereit,
// damit ein künftiger Provider ohne Schema-Änderung andocken kann.
enum PriceSource {
  USER_ENTERED
  IMPORTED
  PROVIDER
}

// Geldbeträge werden ausschließlich als Int-Cent gespeichert (nie als Float),
// um Rundungsfehler zu vermeiden. Prisma unterstützt den `Decimal`-Typ auf
// SQLite nicht (nur auf Postgres/MySQL/SQL Server), Cent-Integer sind hier
// die korrekte, deterministische Alternative. Siehe src/lib/budget/money.ts
// für die einzige Stelle, an der zwischen Euro-Anzeige und Cent umgerechnet
// wird.
//
// Konzeptionell strikt getrennt von PantryItem (physischer Bestand, kein
// Preis) und von FoodPrice (ein bekannter/geschätzter Preis, keine reale
// Ausgabe): FoodBudget ist eine wiederkehrende Einstellung ("60€ pro Woche"),
// keine einzelne Periode-Instanz. Die tatsächlichen Periodengrenzen werden
// deterministisch aus dem aktuellen Datum berechnet (siehe
// src/lib/budget/period.ts), nicht hier gespeichert, damit sie nie veralten
// können. Pro Haushalt und Periodentyp existiert höchstens ein Budget
// (@@unique), wodurch widersprüchliche/parallele Budgets für denselben
// Zeitraumtyp strukturell ausgeschlossen sind. "Budget ändern" = Update
// dieser Zeile, "Budget löschen" = Zeile löschen.
model FoodBudget {
  id          String    @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String

  periodType  BudgetPeriodType
  amountCents Int
  currency    Currency @default(EUR)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([householdId, periodType])
}

// Eine tatsächlich getätigte Ausgabe (reales Geld, reales Datum). Nie
// automatisch aus einem FoodPrice abgeleitet und nie mit einem geschätzten
// Preis verwechselt, siehe FoodPrice-Kommentar.
model FoodExpense {
  id          String    @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String

  amountCents Int
  currency    Currency @default(EUR)
  date        DateTime

  category    FoodExpenseCategory @default(GROCERIES)
  // Freitext, z.B. "Supermarkt" oder "Restaurant XY" (wo Geld ausgegeben wurde).
  source      String?
  // Freitext-Notiz, z.B. "Wocheneinkauf" (zusätzlich zu source, kein Duplikat).
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Ein bekannter/geschätzter Preis für eine Zutat-Menge, NIE eine tatsächliche
// Ausgabe (siehe FoodExpense) und niemals automatisch aus einer Ausgabe
// abgeleitet oder umgekehrt. `householdId` optional: v1 legt nur
// haushaltseigene, nutzereingegebene Preise an, das Feld bleibt nullable für
// einen späteren, nicht haushaltsgebundenen Provider-Preis (z.B. ein
// allgemeiner Marktpreis), ohne dass sich die Form ändern müsste.
// `ingredientId` optional wie bei PantryItem: Verknüpfung zum Katalog, wenn
// vorhanden, sonst Freitext-`name` als Fallback, nie eine erfundene
// Umrechnung zwischen Namen.
model FoodPrice {
  id          String     @id @default(cuid())
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String?

  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id])
  ingredientId String?
  name         String

  priceCents Int
  currency   Currency @default(EUR)
  quantity   Float
  unit       PantryUnit

  source     PriceSource @default(USER_ENTERED)
  observedAt DateTime    @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---- Automatic Meal Planner (Kapitel 10) ----

// Bewusst NICHT `MealPlanDay`/`MealPlanItem` wiederverwendet: diese Modelle
// gehören zum älteren, weiterhin aktiven Single-Profile-Tagesplaner
// (generateMealPlan.ts/planner.ts, Seite /plan) - je Profil genau eine Zeile
// pro Datum (`@@unique([profileId, date])`), ohne Plan-als-eigene-Entität und
// ohne Status-Lebenszyklus. Das deckt sich fachlich NICHT mit dem hier
// geforderten haushaltsweiten, mehrtägigen Plan mit DRAFT/ACTIVE/ARCHIVED-
// Status und mehreren Mitgliedern - eine Wiederverwendung hätte das
// bestehende Modell erweitern müssen (destruktiv für seine heutige Bedeutung)
// oder eine widersprüchliche Doppelbedeutung erzeugt. Beide Systeme bleiben
// bewusst nebeneinander bestehen, siehe Kapitel-10-Bericht.
enum MealPlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model MealPlan {
  id          String    @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String

  name      String?
  startDate DateTime
  endDate   DateTime
  status    MealPlanStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members MealPlanMember[]
  meals   MealPlanMeal[]
}

// Für welche Haushaltsmitglieder dieser Plan berechnet wurde. Explizit
// gespeichert (statt live aus der aktuellen Mitgliederliste abgeleitet),
// damit ein Plan nachvollziehbar bleibt, auch wenn sich die Haushalts-
// Mitgliedschaft später ändert (siehe Kapitel 9: Mitglied kann entfernt
// werden/den Haushalt verlassen).
model MealPlanMember {
  id                String          @id @default(cuid())
  mealPlan          MealPlan        @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  mealPlanId        String
  householdMember   HouseholdMember @relation(fields: [householdMemberId], references: [id], onDelete: Cascade)
  householdMemberId String

  @@unique([mealPlanId, householdMemberId])
}

// Eine geplante Mahlzeit. `householdMemberId` bleibt in Kapitel 10 IMMER
// null: der Plan wird pro Slot für die Summe der geplanten Mitglieder
// EINMAL erzeugt (siehe planningContext.ts), noch ohne echte Per-Person-
// Portionsaufteilung (Dynamic Portions, spätes Kapitel). Das Feld ist bereits
// vorbereitet, damit ein Slot später mehrere Zeilen (eine je Mitglied mit
// eigenem portionMultiplier) tragen kann, ohne das Schema nochmal zu ändern.
model MealPlanMeal {
  id         String   @id @default(cuid())
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  mealPlanId String

  date DateTime
  slot MealSlot

  recipe   Recipe @relation(fields: [recipeId], references: [id])
  recipeId String

  householdMember   HouseholdMember? @relation(fields: [householdMemberId], references: [id], onDelete: SetNull)
  householdMemberId String?

  portionMultiplier Float  @default(1)
  // JSON-Array NUR tatsächlich berechneter Begründungen (siehe mealPlanner/explain.ts),
  // z.B. ["Verwendet deinen Spinat aus dem Vorrat."]. Nie erfundene Texte.
  reasons           String @default("[]")

  createdAt DateTime @default(now())
}

// ---- Evidence Library (wissenschaftliche Grundlage, Kapitel "Evidence Library") ----

// Rein global-fachliche Referenzdaten (Paper + daraus manuell extrahierte,
// mehrfach auditierte Aussagen) - bewusst OHNE jede Beziehung zu Household/
// User/Profile. Das ist kein Versehen: es gibt dadurch strukturell keinen
// Household-/User-Scope, über den diese Daten gefiltert, überschrieben oder
// versehentlich mutiert werden könnten (siehe evidenceService.ts). Eine
// spätere Evidence Engine (Recommendation Confidence, nutzerspezifisches
// Matching, Coach-UI) baut auf diesen Daten auf, ist aber bewusst noch nicht
// Teil dieser Erweiterung - hier werden Claims ausschließlich sauber
// gespeichert und validiert.

enum EvidenceAccessType {
  FULL_TEXT
  ABSTRACT_ONLY
}

// Eine wissenschaftliche Quelle (z.B. ein Paper). Claims hängen an genau
// einer Source (`EvidenceSource` → `EvidenceClaim[]`), damit Zitation/DOI/
// PMID nie pro Claim dupliziert werden müssen.
model EvidenceSource {
  id           String             @id @default(cuid())
  citation     String
  doi          String             @unique
  pmid         String?            @unique
  pmcid        String?
  accessedText EvidenceAccessType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claims EvidenceClaim[]
}

enum EvidenceClaimType {
  EVIDENCE_FINDING
  AUTHOR_INTERPRETATION
  PRACTICAL_RECOMMENDATION
  CONTEXTUAL_LIMITATION
}

enum EvidenceStrength {
  HIGH
  MODERATE
  LIMITED
  UNCERTAIN
}

enum EvidenceDirection {
  INCREASE
  DECREASE
  MAINTAIN
  CONDITIONAL
  NO_EFFECT
}

enum EvidenceClaimStatus {
  VERIFIED
  PENDING_FULL_TEXT
  REJECTED
}

// Ein manuell geprüfter, quellentreuer Claim (siehe Evidence-Library-Audit-
// Prozess: mehrfache Volltextverifikation vor Freigabe). `claimId` ist der
// stabile, fachlich vergebene Schlüssel (z.B. "KERK17_CHO_PRE_ENDURANCE"),
// über den der Seed idempotent upsertet - NICHT die interne `id`, die wie
// überall sonst im Schema ein cuid bleibt.
//
// `evidenceStrength` ist unsere eigene, konservative interne Einschätzung
// der Evidenzqualität für GENAU DIESEN Claim, nie das Grading der Quelle
// selbst (Kerksick et al. 2017 verwendet kein formales Evidence-Grading-
// System) - deshalb bewusst ein einzelner Enum-Wert, kein Freitext, in dem
// z.B. "MODERATE/LIMITED" möglich wäre. `recommendationConfidence` wird
// bewusst NICHT hier gespeichert - das ist Aufgabe der späteren Evidence
// Engine, die den Claim mit einem konkreten Nutzerkontext abgleicht.
model EvidenceClaim {
  id       String         @id @default(cuid())
  source   EvidenceSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId String

  claimId String @unique

  claimType EvidenceClaimType
  topic     String
  statement String

  population          String?
  trainingContext     String?
  trainingType        String?
  intensityOrDuration String?
  nutritionContext    String?
  timingContext       String?

  direction        EvidenceDirection
  evidenceStrength EvidenceStrength

  // JSON-Array wie mealSlots/dietTypes/allergens/tags andernorts im Schema
  // (SQLite kennt keine nativen Arrays), siehe format.ts-Konventionen.
  limitations String @default("[]")

  justification String

  status EvidenceClaimStatus @default(VERIFIED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceId])
}

// ---- Contextual Insights (Kapitel 12) ----

// Insights selbst werden NIE gespeichert - sie sind pro Aufruf deterministisch
// aus bestehenden Daten (Pantry/MealPlanDay/Budget/Recipe) neu berechnet
// (siehe src/lib/insights/insightService.ts). "resolved" braucht deshalb
// keine eigene Tabelle: sobald die zugrunde liegende Bedingung nicht mehr
// zutrifft, erzeugt der nächste Lauf das Insight einfach nicht mehr erneut.
// Nur "dismissed" (eine explizite Nutzerentscheidung) muss über den nächsten
// Seitenaufruf hinweg erhalten bleiben - dafür genau diese eine schlanke
// Tabelle. `insightKey` ist die stabile ID aus insights/types.ts (Entität +
// Regel + relevanter Zeitbucket, z.B. "pantry:expiring-soon:<id>:1"), NIE die
// interne `id` dieser Zeile. Pro Profil (nicht Haushalt): jedes
// Haushaltsmitglied blendet Insights auf seinem eigenen Dashboard unabhängig
// aus, auch wenn die zugrunde liegenden Pantry-/Budget-Daten geteilt sind
// (deckt sich mit LogEntry/MealPlanDay, die ebenfalls pro Profil laufen).
model DismissedInsight {
  id         String   @id @default(cuid())
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId  String
  insightKey String
  dismissedAt DateTime @default(now())

  @@unique([profileId, insightKey])
}
