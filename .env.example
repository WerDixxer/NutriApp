# Vorlage für die lokale .env (siehe README, Abschnitt "Umgebungsvariablen").
# Keine echten Werte in diese Datei eintragen - sie ist eingecheckt.
#
# Die Werte werden beim Serverstart geprüft (src/lib/config/env.ts): in
# Produktion (NODE_ENV=production) bricht eine fehlende oder ungültige
# Pflichtangabe den Start ab, in der Entwicklung gibt es nur eine Warnung.

# Datenbank (SQLite lokal). Der Pfad ist relativ zu prisma/schema.prisma,
# die Datei liegt also unter prisma/dev.db. Die Prisma-CLI liest nur .env.
# Pflicht in jeder Umgebung.
DATABASE_URL="file:./dev.db"

# LLM-Provider für den Food Assistant. "anthropic" ist aktuell die einzige
# Implementierung; das Provider-Interface (src/lib/agents/llmProvider.ts)
# ist so gebaut, dass weitere Provider (z.B. "openai") ergänzt werden können,
# ohne die Agent-Logik anzufassen. LLM_MODEL muss eines der in
# src/lib/config/env.ts gelisteten Modelle sein (Standard: claude-sonnet-5).
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5

# Trag deinen echten Key nur in eine lokale, nicht eingecheckte .env-Datei ein
# (niemals in .env.example oder ins Repo committen). In der Entwicklung
# optional: ohne Key funktioniert alles außer dem Food Assistant
# (/api/assistant antwortet dann mit 503). In Produktion Pflicht.
ANTHROPIC_API_KEY=

# Barcode-Nährwerte (/api/nutrition/lookup). Optional, Standard ist
# "openfoodfacts" (einziger unterstützter Wert, kein Key nötig, braucht
# Netzwerkzugriff auf world.openfoodfacts.org).
# NUTRITION_PROVIDER=openfoodfacts

# Auth.js: Signaturschlüssel für JWT-Sessions, in JEDER Umgebung Pflicht,
# in Produktion mindestens 32 Zeichen. Lokal generieren, z.B. mit:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Nur für selbst gehostete Produktion (NODE_ENV=production, nicht Vercel):
# Auth.js vertraut dem Host sonst nicht und bricht mit "UntrustedHost" ab.
# Entweder AUTH_TRUST_HOST=true (hinter einem vertrauenswürdigen Proxy) oder
# die öffentliche Basis-URL als AUTH_URL setzen. Lokal nicht nötig.
# AUTH_TRUST_HOST akzeptiert nur "true" - Auth.js würde auch "false" als
# "true" behandeln; zum Abschalten die Variable weglassen.
# AUTH_TRUST_HOST=true
# AUTH_URL=https://vyn.example.org

# Zugriff auf interne Tools (/internal/recipe-review): kommagetrennte
# E-Mail-Adressen eingeloggter Nutzer (Groß-/Kleinschreibung egal). Gilt in
# JEDER Umgebung - ist die Variable leer, hat niemand Zugriff, auch nicht bei
# `npm run dev`. Lokal die eigene E-Mail eintragen. Nie für "alle" öffnen:
# ein Dev-Server kann z.B. per Tunnel öffentlich erreichbar sein.
INTERNAL_REVIEW_EMAILS=
